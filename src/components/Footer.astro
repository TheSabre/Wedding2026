---
// Footer — warm teak/sandalwood background, cream text.
---

<footer class="footer">
  <div class="footer__border" aria-hidden="true">
    <svg viewBox="0 0 400 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="3" x2="400" y2="3" stroke="var(--color-gold)" stroke-width="1.5" />
      <line x1="0" y1="17" x2="400" y2="17" stroke="var(--color-gold-light)" stroke-width="1" />
      <g stroke="var(--color-gold)" stroke-width="1.2" fill="none">
        <path d="M10 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M50 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M90 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M130 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M170 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M210 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M250 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M290 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M330 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
        <path d="M370 10c3-4 7-4 10 0c-3 4-7 4-10 0Z" />
      </g>
    </svg>
  </div>

  <div class="footer__content">
    <p class="footer__blessing">
      May the blessings of Guruvayurappan be upon you and your family.
    </p>
    <p class="footer__names">Vishnu &amp; Apurva</p>
    <p class="footer__date">December 12, 2026 · Guruvayur, Kerala</p>
    <p class="footer__families">With Best Wishes from Pisharody and Nambiar Families</p>
  </div>
</footer>

<style>
  .footer {
    /* Warm sandalwood / teak — complements kasavu cream palette */
    background-color: #3B2416;
    color: var(--color-text-on-dark);
    text-align: center;
    padding: var(--space-7) var(--section-padding-x)
      calc(var(--space-7) + 64px);
  }

  .footer__border {
    max-width: var(--page-max-width);
    margin: 0 auto var(--space-6);
  }

  .footer__border svg {
    width: 100%;
    height: 20px;
  }

  .footer__content {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__blessing {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: var(--color-gold-light);
    font-style: italic;
  }

  .footer__names {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    color: var(--color-text-on-dark);
    letter-spacing: var(--ls-display);
  }

  .footer__date {
    font-family: var(--font-display);
    letter-spacing: var(--ls-label);
    font-size: var(--fs-body-sm);
    color: var(--color-gold-light);
  }

  .footer__families {
    font-size: var(--fs-body-sm);
    color: rgba(251, 246, 236, 0.6);
    letter-spacing: 0.04em;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(201, 162, 39, 0.25);
  }

  @media (min-width: 768px) {
    .footer {
      padding-bottom: var(--space-7);
    }
  }
</style>
