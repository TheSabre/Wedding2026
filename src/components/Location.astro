---
// Venue / location section with Google Maps embed and directions link.

const mapsEmbedSrc =
  'https://www.google.com/maps?q=Elite+Hotel+East+Nada+Guruvayur+Kerala&output=embed';
const directionsUrl =
  'https://www.google.com/maps/search/?api=1&query=Elite+Hotel,+East+Nada,+Kuppaayil,+Guruvayur,+Kerala+680101';
---

<section id="location" class="location">
  <div class="section-inner">
    <h2 class="section-heading">Venue</h2>

    <div class="location__venues">
      <div class="location__venue-item">
        <p class="location__venue-label">Thaali Kettu</p>
        <p class="location__venue-name">Guruvayur Sree Krishna Temple</p>
        <p class="location__venue-address">East Nada, Guruvayur, Thrissur District, Kerala 680101</p>
      </div>
      <div class="location__venue-divider" aria-hidden="true">✦</div>
      <div class="location__venue-item">
        <p class="location__venue-label">Wedding Ceremony &amp; Sadya</p>
        <p class="location__venue-name">Elite Hotel</p>
        <p class="location__venue-address">East Nada, Kuppaayil, Guruvayur, Kerala 680101</p>
      </div>
    </div>

    <div class="location__map">
      <iframe
        src={mapsEmbedSrc}
        title="Map showing Elite Hotel, Guruvayur"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>

    <a class="location__cta" href={directionsUrl} target="_blank" rel="noopener noreferrer">
      Get Directions to Elite Hotel
    </a>
  </div>
</section>

<style>
  .location {
    padding: var(--section-padding-y) var(--section-padding-x);
    max-width: var(--page-max-width);
    margin: 0 auto;
  }

  .location__venues {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    text-align: center;
  }

  @media (min-width: 640px) {
    .location__venues {
      flex-direction: row;
      justify-content: center;
      align-items: flex-start;
    }
  }

  .location__venue-item {
    flex: 1;
    max-width: 280px;
  }

  .location__venue-label {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-gold-deep);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .location__venue-name {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    color: var(--color-maroon);
    margin-bottom: var(--space-1);
  }

  .location__venue-address {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .location__venue-divider {
    color: var(--color-gold-light);
    font-size: var(--fs-display-md);
    padding: 0 var(--space-4);
    align-self: center;
  }

  .location__map {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-width-hairline) solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .location__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location__cta {
    display: block;
    width: fit-content;
    margin: var(--space-6) auto 0;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-maroon);
    color: var(--color-text-on-dark);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    font-size: var(--fs-body-sm);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .location__cta:hover {
    background-color: var(--color-maroon-deep);
  }
</style>
