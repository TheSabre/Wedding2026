---
// Hero section — Om invocation, names with parentage, couple silhouette, and invitation text.
import ganeshSvg from '../../icons/ganesh.svg?raw';
import brideGroomImg from '../../images/bride_and_groom.jpg';
---

<section id="home" class="hero">
  <div class="hero__inner">

    <!-- Om invocation with Ganesh icon -->
    <div class="hero__invocation">
      <div class="ganesh-icon" role="img" aria-label="Ganesha" set:html={ganeshSvg} />
      <p class="hero__om">ॐ श्री गणेशाय नमः</p>
      <p class="hero__om-latin">Om Shree Ganeshaya Namaha</p>
    </div>

    <!-- Eyebrow -->
    <p class="eyebrow hero__eyebrow">Together with their families</p>

    <!-- Couple names with parentage -->
    <div class="hero__couple-names">
      <div class="hero__person">
        <h1 class="hero__name">Vishnu</h1>
        <p class="hero__parentage">S/o Mr T.P Sasidharan<br />and Jaya Pisharody</p>
      </div>
      <span class="hero__ampersand">&amp;</span>
      <div class="hero__person">
        <h1 class="hero__name">Apurva</h1>
        <p class="hero__parentage">D/o Mr P.M Gangadharan Nambiar<br />and Bhanu Nambiar</p>
      </div>
    </div>

    <!-- Bride & Groom photo -->
    <div class="hero__silhouette">
      <img
        src={brideGroomImg.src ?? brideGroomImg}
        alt="Bride and Groom"
        class="hero__couple-photo"
        loading="lazy"
        decoding="async"
      />
    </div>

    <p class="hero__date">December 12, 2026</p>

    <!-- Decorative nilavilakku divider -->
    <svg
      class="hero__motif"
      viewBox="0 0 200 120"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Nilavilakku, a traditional Kerala oil lamp"
    >
      <path
        d="M100 14c-6 8-9 14-9 20a9 9 0 0 0 18 0c0-6-3-12-9-20Z"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <line x1="100" y1="43" x2="100" y2="78" stroke="var(--color-gold)" stroke-width="1.5" />
      <path
        d="M78 78c0 10 10 18 22 18s22-8 22-18"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <line x1="78" y1="78" x2="122" y2="78" stroke="var(--color-gold)" stroke-width="1.5" />
      <path
        d="M88 96c0 6 5.4 10 12 10s12-4 12-10"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <line x1="100" y1="96" x2="100" y2="106" stroke="var(--color-gold)" stroke-width="1.5" />
      <line x1="84" y1="106" x2="116" y2="106" stroke="var(--color-gold)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="10" y1="78" x2="68" y2="78" stroke="var(--color-gold-light)" stroke-width="1.5" stroke-linecap="round" />
      <line x1="132" y1="78" x2="190" y2="78" stroke="var(--color-gold-light)" stroke-width="1.5" stroke-linecap="round" />
    </svg>

    <!-- Greeting and invitation -->
    <div class="hero__text">
      <p class="hero__greeting">
        <em>With hearts full of joy and souls overflowing with gratitude,<br />we seek your gracious presence.</em>
      </p>

      <p class="hero__invitation">
        We invite you to witness and bless the auspicious union of our beloved children as they take their sacred vows in the presence of God, family, and friends. Your presence on this blessed occasion shall fill our hearts with joy and our home with divine grace.
      </p>

      <p class="hero__closing">
        Your presence and your blessing are the only gifts we hope to receive.
      </p>
    </div>

  </div>
</section>

<style>
  .hero {
    padding: var(--section-padding-y) var(--section-padding-x);
    max-width: var(--page-max-width);
    margin: 0 auto;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    text-align: center;
  }

  /* ── Om / Ganesh invocation ── */
  .hero__invocation {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  /* Inlined Ganesh SVG — override black fills to gold, hide attribution text */
  .ganesh-icon :global(svg) {
    width: 64px;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .ganesh-icon :global(svg path),
  .ganesh-icon :global(svg circle),
  .ganesh-icon :global(svg ellipse),
  .ganesh-icon :global(svg rect) {
    fill: var(--color-gold) !important;
    stroke: none !important;
  }

  .ganesh-icon :global(svg text) {
    display: none;
  }

  .hero__om {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    color: var(--color-gold-deep);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .hero__om-latin {
    font-family: var(--font-display);
    font-size: var(--fs-body-sm);
    letter-spacing: var(--ls-label);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    margin: 0;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-5);
    display: block;
  }

  /* ── Couple names ── */
  .hero__couple-names {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .hero__person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__name {
    font-size: var(--fs-display-xl);
    color: var(--color-maroon);
    margin: 0;
  }

  .hero__parentage {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  .hero__ampersand {
    font-family: var(--font-display);
    font-size: var(--fs-display-lg);
    color: var(--color-gold);
    margin-top: var(--space-3);
    align-self: flex-start;
  }

  /* ── Couple photo ── */
  .hero__silhouette {
    width: min(100%, 480px);
    margin: var(--space-6) auto;
  }

  .hero__couple-photo {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-gold-light);
    box-shadow: var(--shadow-card-lg);
  }

  /* ── Date ── */
  .hero__date {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    letter-spacing: var(--ls-label);
    color: var(--color-text-secondary);
    margin-top: var(--space-3);
  }

  /* ── Nilavilakku motif ── */
  .hero__motif {
    width: min(100%, 200px);
    margin: var(--space-7) auto var(--space-6);
    opacity: var(--motif-opacity-visible);
  }

  /* ── Invitation text ── */
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 42ch;
    margin-inline: auto;
  }

  .hero__greeting {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: var(--color-maroon);
    line-height: 1.7;
  }

  .hero__invitation {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .hero__closing {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: 600;
    color: var(--color-gold-deep);
    letter-spacing: 0.01em;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }
</style>
