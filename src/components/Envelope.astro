---
// Full-screen envelope landing overlay.
// Multi-phase animation: flap opens → card rises → card expands → overlay fades.
// Shown once per session (sessionStorage).
---

<div id="envelope-overlay" class="envelope-overlay">
  <!-- Invitation card that emerges and expands to cover the screen -->
  <div class="card-backdrop" aria-hidden="true">
    <p class="card-backdrop__om">ॐ श्री गणेशाय नमः</p>
    <p class="card-backdrop__names">Vishnu &amp; Apurva</p>
    <p class="card-backdrop__date">December 12, 2026</p>
  </div>

  <button
    id="envelope-trigger"
    class="envelope-trigger"
    type="button"
    aria-label="Open wedding invitation"
  >
    <div class="envelope-graphic" aria-hidden="true">
      <svg
        class="envelope-svg"
        viewBox="0 0 320 220"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
      >
        <!-- Envelope body -->
        <rect
          x="10"
          y="20"
          width="300"
          height="190"
          rx="8"
          fill="var(--color-ivory)"
          stroke="var(--color-gold)"
          stroke-width="2"
        />
        <!-- Back flap shadow lines -->
        <path
          d="M10 28 L160 150 L310 28"
          fill="none"
          stroke="var(--color-gold-light)"
          stroke-width="1.5"
        />
        <!-- Front flap (triangle) -->
        <path
          id="envelope-flap"
          class="envelope-flap"
          d="M10 20 L160 130 L310 20 Z"
          fill="var(--color-cream-deep)"
          stroke="var(--color-gold)"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <!-- Wax seal -->
        <g id="envelope-seal" class="envelope-seal">
          <circle cx="160" cy="115" r="26" fill="var(--color-maroon)" />
          <circle
            cx="160"
            cy="115"
            r="26"
            fill="none"
            stroke="var(--color-gold-light)"
            stroke-width="1.5"
          />
          <!-- Ganesh trunk motif on seal -->
          <path
            d="M153 103 C148 108 146 116 150 122 C152 125 156 125 158 122"
            fill="none"
            stroke="var(--color-gold-light)"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <ellipse cx="155" cy="100" rx="8" ry="10" fill="none" stroke="var(--color-gold-light)" stroke-width="1.2"/>
          <ellipse cx="145" cy="102" rx="5" ry="7" fill="none" stroke="var(--color-gold-light)" stroke-width="1"/>
          <ellipse cx="165" cy="102" rx="5" ry="7" fill="none" stroke="var(--color-gold-light)" stroke-width="1"/>
        </g>
      </svg>
    </div>

    <div class="envelope-text">
      <p class="envelope-names">Vishnu &amp; Apurva</p>
      <p class="envelope-date">12 . 12 . 2026</p>
      <p class="envelope-prompt">Tap to open</p>
    </div>
  </button>
</div>

<noscript>
  <style>
    .envelope-overlay {
      display: none;
    }
  </style>
</noscript>

<style>
  .envelope-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-envelope);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-cream);
    background-image: radial-gradient(
      circle at center,
      var(--color-cream-deep) 0%,
      var(--color-cream) 70%
    );
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  /* ── Card backdrop that rises and expands ── */
  .card-backdrop {
    position: fixed;
    inset: 0;
    background: var(--color-ivory);
    /* Start: small card shape near bottom-center (behind envelope) */
    clip-path: inset(40% 28% 10% 28% round 12px);
    opacity: 0;
    z-index: 1; /* above the trigger button's background */
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    transition: opacity 0.5s ease;
  }

  .card-backdrop__om {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    color: var(--color-gold-deep);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.2s, transform 0.5s ease 0.2s;
  }

  .card-backdrop__names {
    font-family: var(--font-display);
    font-size: var(--fs-display-lg);
    font-weight: 600;
    color: var(--color-maroon);
    letter-spacing: var(--ls-display);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.4s, transform 0.5s ease 0.4s;
  }

  .card-backdrop__date {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: var(--color-text-secondary);
    letter-spacing: var(--ls-label);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.6s, transform 0.5s ease 0.6s;
  }

  /* Phase: flap opens → card appears as small card (rising from envelope) */
  .envelope-overlay.phase-card .card-backdrop {
    opacity: 1;
    clip-path: inset(16% 12% 16% 12% round 16px);
    transition: opacity 0.4s ease,
      clip-path 1.1s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .envelope-overlay.phase-card .card-backdrop__om,
  .envelope-overlay.phase-card .card-backdrop__names,
  .envelope-overlay.phase-card .card-backdrop__date {
    opacity: 1;
    transform: translateY(0);
  }

  /* Phase: card expands to fill the entire screen */
  .envelope-overlay.phase-expand .card-backdrop {
    opacity: 1;
    clip-path: inset(0% 0% 0% 0% round 0px);
    transition: clip-path 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Phase: entire overlay fades out revealing website */
  .envelope-overlay.phase-done {
    opacity: 0;
    visibility: hidden;
  }

  .envelope-overlay.is-removed {
    display: none;
  }

  /* ── Envelope trigger ── */
  .envelope-trigger {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-5);
    font-family: inherit;
    color: inherit;
    opacity: 1;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .envelope-overlay.phase-flap .envelope-trigger {
    opacity: 0;
    transform: scale(0.92) translateY(-8px);
  }

  .envelope-graphic {
    width: min(80vw, 320px);
  }

  .envelope-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .envelope-flap {
    transform-origin: 160px 20px;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s ease;
  }

  .envelope-seal {
    transform-origin: 160px 115px;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.8, 0.6),
      opacity 0.5s ease;
  }

  .envelope-overlay.phase-flap .envelope-flap {
    transform: rotateX(180deg);
    opacity: 0;
  }

  .envelope-overlay.phase-flap .envelope-seal {
    transform: scale(0.2);
    opacity: 0;
  }

  /* ── Text below envelope ── */
  .envelope-text {
    text-align: center;
  }

  .envelope-names {
    font-family: var(--font-display);
    font-size: var(--fs-display-lg);
    font-weight: 600;
    letter-spacing: var(--ls-display);
    color: var(--color-maroon);
    margin: 0;
  }

  .envelope-date {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    letter-spacing: var(--ls-label);
    color: var(--color-text-secondary);
    margin: var(--space-2) 0 var(--space-5);
  }

  .envelope-prompt {
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-gold-deep);
    font-weight: 600;
    animation: envelope-pulse 2.4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .envelope-prompt {
      animation: none;
    }
  }

  @keyframes envelope-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-4px);
    }
  }
</style>

<script>
  const STORAGE_KEY = 'envelope-opened';
  const overlay = document.getElementById('envelope-overlay') as HTMLElement | null;
  const trigger = document.getElementById('envelope-trigger') as HTMLButtonElement | null;

  if (overlay && trigger) {
    const alreadyOpened = sessionStorage.getItem(STORAGE_KEY) === 'true';

    if (alreadyOpened) {
      overlay.classList.add('is-removed');
      document.body.classList.remove('no-scroll');
    } else {
      document.body.classList.add('no-scroll');
    }

    const openEnvelope = () => {
      if (overlay.classList.contains('phase-flap')) return;

      sessionStorage.setItem(STORAGE_KEY, 'true');

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (prefersReducedMotion) {
        overlay.classList.add('phase-done', 'is-removed');
        document.body.classList.remove('no-scroll');
        return;
      }

      // Phase 1: Flap opens + trigger fades (0–900ms)
      overlay.classList.add('phase-flap');

      // Phase 2: Card rises from envelope (800–1900ms)
      window.setTimeout(() => {
        overlay.classList.add('phase-card');
      }, 800);

      // Phase 3: Card expands to fill screen (1700–2900ms)
      window.setTimeout(() => {
        overlay.classList.add('phase-expand');
      }, 1700);

      // Phase 4: Overlay fades out, website revealed (2800ms+)
      window.setTimeout(() => {
        overlay.classList.add('phase-done');
        document.body.classList.remove('no-scroll');
      }, 2800);

      // Remove overlay from DOM after animation (3600ms)
      window.setTimeout(() => {
        overlay.classList.add('is-removed');
      }, 3700);
    };

    trigger.addEventListener('click', openEnvelope);
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        openEnvelope();
      }
    });
  }
</script>
