---
// Vertical timeline of the day's events.
---

<section id="schedule" class="schedule">
  <div class="section-inner">
    <h2 class="section-heading">Schedule</h2>

    <ol class="schedule__timeline">

      <!-- ── Thaali Kettu ── -->
      <li class="schedule__item">
        <div class="schedule__marker" aria-hidden="true">
          <!-- Thaali / mangalsutra icon -->
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Chain arc -->
            <path
              d="M5 8 C5 4 19 4 19 8"
              stroke="var(--color-gold)"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <!-- Chain dots -->
            <circle cx="8" cy="7" r="1" fill="var(--color-gold)" />
            <circle cx="12" cy="6" r="1" fill="var(--color-gold)" />
            <circle cx="16" cy="7" r="1" fill="var(--color-gold)" />
            <!-- Pendant (thaali leaf) -->
            <path
              d="M12 10 C9 10 8 13 8 16 C8 19 10 21 12 21 C14 21 16 19 16 16 C16 13 15 10 12 10 Z"
              stroke="var(--color-gold)"
              stroke-width="1.5"
            />
            <!-- Pendant centre line -->
            <line x1="12" y1="11" x2="12" y2="20" stroke="var(--color-gold)" stroke-width="1" stroke-linecap="round" />
          </svg>
        </div>
        <div class="schedule__content">
          <p class="schedule__time">7:00 AM</p>
          <h3 class="schedule__title">Thaali Kettu</h3>
          <p class="schedule__location">
            Guruvayur Sree Krishna Temple<br />
            East Nada, Guruvayur, Thrissur District, Kerala 680101
          </p>
        </div>
      </li>

      <!-- ── Wedding Ceremony ── -->
      <li class="schedule__item">
        <div class="schedule__marker" aria-hidden="true">
          <!-- Temple bell / wedding icon -->
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Joined hands / clasped hands (vivaha) -->
            <path
              d="M7 13 C7 10 9 8 12 8 C15 8 17 10 17 13"
              stroke="var(--color-gold)"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <!-- Left hand -->
            <path
              d="M5 14 L5 18 C5 19.5 6 20 7 20 L11 20"
              stroke="var(--color-gold)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <!-- Right hand -->
            <path
              d="M19 14 L19 18 C19 19.5 18 20 17 20 L13 20"
              stroke="var(--color-gold)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <!-- Centre connector (tying the knot) -->
            <line x1="11" y1="20" x2="13" y2="20" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" />
            <!-- Flower / auspicious mark above -->
            <path
              d="M12 5 C11 3 9 3 9 5 C9 7 12 7 12 5 Z"
              fill="var(--color-gold)"
            />
            <path
              d="M12 5 C13 3 15 3 15 5 C15 7 12 7 12 5 Z"
              fill="var(--color-gold)"
            />
            <circle cx="12" cy="6" r="1.5" fill="var(--color-gold)" />
          </svg>
        </div>
        <div class="schedule__content">
          <p class="schedule__time">11:00 AM</p>
          <h3 class="schedule__title">Wedding Ceremony</h3>
          <p class="schedule__location">
            Elite Hotel<br />
            East Nada, Kuppaayil, Guruvayur, Kerala 680101
          </p>
        </div>
      </li>

      <!-- ── Lunch / Sadya ── -->
      <li class="schedule__item">
        <div class="schedule__marker" aria-hidden="true">
          <!-- Banana leaf (sadya) icon -->
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Banana leaf shape -->
            <path
              d="M3 19 C3 19 6 8 12 5 C18 2 21 5 21 5 C21 5 18 16 12 19 C6 22 3 19 3 19 Z"
              stroke="var(--color-gold)"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <!-- Central vein -->
            <line x1="12" y1="5" x2="8" y2="19" stroke="var(--color-gold)" stroke-width="1" stroke-linecap="round" />
            <!-- Side veins -->
            <line x1="10" y1="9" x2="17" y2="8" stroke="var(--color-gold)" stroke-width="0.8" stroke-linecap="round" />
            <line x1="9" y1="13" x2="17" y2="11" stroke="var(--color-gold)" stroke-width="0.8" stroke-linecap="round" />
            <line x1="8" y1="17" x2="16" y2="15" stroke="var(--color-gold)" stroke-width="0.8" stroke-linecap="round" />
          </svg>
        </div>
        <div class="schedule__content">
          <p class="schedule__time">12:30 PM</p>
          <h3 class="schedule__title">Lunch / Sadya</h3>
          <p class="schedule__location">
            Elite Hotel<br />
            East Nada, Kuppaayil, Guruvayur, Kerala 680101
          </p>
        </div>
      </li>

    </ol>
  </div>
</section>

<style>
  .schedule {
    padding: var(--section-padding-y) var(--section-padding-x);
    max-width: var(--page-max-width);
    margin: 0 auto;
    background-color: var(--color-cream-deep);
  }

  .schedule__timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Gold vertical line */
  .schedule__timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 19px;
    width: var(--border-width-accent);
    background-color: var(--color-gold-light);
  }

  .schedule__item {
    position: relative;
    display: flex;
    gap: var(--space-5);
    padding-left: 0;
    padding-bottom: var(--space-7);
  }

  .schedule__item:last-child {
    padding-bottom: 0;
  }

  .schedule__marker {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-cream);
    border: var(--border-width-hairline) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .schedule__marker svg {
    width: 22px;
    height: 22px;
  }

  .schedule__time {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: var(--color-maroon);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .schedule__title {
    font-size: var(--fs-display-md);
    margin-bottom: var(--space-1);
  }

  .schedule__location {
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: 1.6;
  }
</style>
