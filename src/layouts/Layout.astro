---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vishnu & Apurva | December 12, 2026',
  description = 'Join us as we celebrate the wedding of Vishnu & Apurva — December 12, 2026, Guruvayoor, Kerala.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Ganesh / Om favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2226%22 font-size=%2228%22>🕉️</text></svg>" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Cormorant Garamond + Mukta -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Mukta:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Golden Indian border frame (pointer-events: none — does not block interaction) -->
    <div class="border-frame" aria-hidden="true">
      <!-- Corner ornaments -->
      <svg class="corner-ornament corner-ornament--tl" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 62 L2 22 C2 10 10 2 22 2 L62 2" stroke="#C9A227" stroke-width="2"/>
        <path d="M8 62 L8 26 C8 16 16 8 26 8 L62 8" stroke="#E8CE7A" stroke-width="1"/>
        <!-- Lotus corner -->
        <circle cx="20" cy="20" r="5" stroke="#C9A227" stroke-width="1.5"/>
        <path d="M20 15 L20 10 M15 20 L10 20 M20 25 L20 30 M25 20 L30 20" stroke="#C9A227" stroke-width="1" stroke-linecap="round"/>
        <path d="M16.5 16.5 L13 13 M23.5 16.5 L27 13 M16.5 23.5 L13 27 M23.5 23.5 L27 27" stroke="#C9A227" stroke-width="0.8" stroke-linecap="round"/>
        <!-- Decorative dots -->
        <circle cx="8" cy="40" r="2" fill="#C9A227"/>
        <circle cx="40" cy="8" r="2" fill="#C9A227"/>
      </svg>

      <svg class="corner-ornament corner-ornament--tr" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M62 62 L62 22 C62 10 54 2 42 2 L2 2" stroke="#C9A227" stroke-width="2"/>
        <path d="M56 62 L56 26 C56 16 48 8 38 8 L2 8" stroke="#E8CE7A" stroke-width="1"/>
        <circle cx="44" cy="20" r="5" stroke="#C9A227" stroke-width="1.5"/>
        <path d="M44 15 L44 10 M49 20 L54 20 M44 25 L44 30 M39 20 L34 20" stroke="#C9A227" stroke-width="1" stroke-linecap="round"/>
        <path d="M47.5 16.5 L51 13 M40.5 16.5 L37 13 M47.5 23.5 L51 27 M40.5 23.5 L37 27" stroke="#C9A227" stroke-width="0.8" stroke-linecap="round"/>
        <circle cx="56" cy="40" r="2" fill="#C9A227"/>
        <circle cx="24" cy="8" r="2" fill="#C9A227"/>
      </svg>

      <svg class="corner-ornament corner-ornament--bl" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 2 L2 42 C2 54 10 62 22 62 L62 62" stroke="#C9A227" stroke-width="2"/>
        <path d="M8 2 L8 38 C8 48 16 56 26 56 L62 56" stroke="#E8CE7A" stroke-width="1"/>
        <circle cx="20" cy="44" r="5" stroke="#C9A227" stroke-width="1.5"/>
        <path d="M20 39 L20 34 M15 44 L10 44 M20 49 L20 54 M25 44 L30 44" stroke="#C9A227" stroke-width="1" stroke-linecap="round"/>
        <path d="M16.5 40.5 L13 37 M23.5 40.5 L27 37 M16.5 47.5 L13 51 M23.5 47.5 L27 51" stroke="#C9A227" stroke-width="0.8" stroke-linecap="round"/>
        <circle cx="8" cy="24" r="2" fill="#C9A227"/>
        <circle cx="40" cy="56" r="2" fill="#C9A227"/>
      </svg>

      <svg class="corner-ornament corner-ornament--br" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M62 2 L62 42 C62 54 54 62 42 62 L2 62" stroke="#C9A227" stroke-width="2"/>
        <path d="M56 2 L56 38 C56 48 48 56 38 56 L2 56" stroke="#E8CE7A" stroke-width="1"/>
        <circle cx="44" cy="44" r="5" stroke="#C9A227" stroke-width="1.5"/>
        <path d="M44 39 L44 34 M49 44 L54 44 M44 49 L44 54 M39 44 L34 44" stroke="#C9A227" stroke-width="1" stroke-linecap="round"/>
        <path d="M47.5 40.5 L51 37 M40.5 40.5 L37 37 M47.5 47.5 L51 51 M40.5 47.5 L37 51" stroke="#C9A227" stroke-width="0.8" stroke-linecap="round"/>
        <circle cx="56" cy="24" r="2" fill="#C9A227"/>
        <circle cx="24" cy="56" r="2" fill="#C9A227"/>
      </svg>
    </div>

    <slot />
  </body>
</html>

<script>
  // Scroll-reveal: adds .is-visible to elements with [data-reveal] as they enter viewport.
  if ('IntersectionObserver' in window) {
    const targets = document.querySelectorAll(
      '.hero__invocation, .hero__couple-names, .hero__silhouette, .hero__text, ' +
      '.schedule__item, .location__venues, .location__map, footer'
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    targets.forEach((el) => {
      el.classList.add('reveal');
      observer.observe(el);
    });
  }
</script>

<style is:global>
  /* ── Golden border frame ── */
  .border-frame {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9990;
    /* Double-line golden border via layered inset box-shadows */
    box-shadow:
      inset 0 0 0 5px #C9A227,
      inset 0 0 0 9px #FBF6EC,
      inset 0 0 0 12px #E8CE7A,
      inset 0 0 0 16px #FBF6EC,
      inset 0 0 0 18px rgba(201, 162, 39, 0.4);
  }

  /* Corner ornaments */
  .corner-ornament {
    position: fixed;
    width: 64px;
    height: 64px;
    pointer-events: none;
    z-index: 9991;
  }

  .corner-ornament--tl { top: 0; left: 0; }
  .corner-ornament--tr { top: 0; right: 0; }
  .corner-ornament--bl { bottom: 0; left: 0; }
  .corner-ornament--br { bottom: 0; right: 0; }

  /* ── Scroll reveal animation ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.75s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
